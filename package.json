{
  "name": "mira",
  "private": true,
  "description": "One sky for all my agent work.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning hub/src/main.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch hub/src/main.ts",
    "hub:background": "node --disable-warning=ExperimentalWarning hub/src/control.ts start",
    "hub:stop": "node --disable-warning=ExperimentalWarning hub/src/control.ts stop",
    "hub:restart": "node --disable-warning=ExperimentalWarning hub/src/control.ts restart",
    "hub:status": "node --disable-warning=ExperimentalWarning hub/src/control.ts status",
    "hub:login": "node --disable-warning=ExperimentalWarning hub/src/control.ts login",
    "hub:login-off": "node --disable-warning=ExperimentalWarning hub/src/control.ts login-off",
    "update": "node --disable-warning=ExperimentalWarning hub/src/updater.ts",
    "app": "electron app",
    "icons": "node app/icons.ts",
    "typecheck": "tsc -p . && tsc -p tsconfig.web.json",
    "test": "node --disable-warning=ExperimentalWarning --test \"contracts/test/*.test.ts\" \"hub/test/*.test.ts\"",
    "contract:schema": "node contracts/scripts/emit-schema.ts",
    "recorder": "node tools/hook-recorder/recorder.mjs"
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "phaser": "3.90.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.1",
    "electron": "44.9.3",
    "typescript": "7.0.2"
  }
}
