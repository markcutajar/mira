{
  "name": "mira",
  "private": true,
  "description": "One sky for all my agent work.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning hub/src/main.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch hub/src/main.ts",
    "typecheck": "tsc -p . && tsc -p tsconfig.web.json",
    "test": "node --disable-warning=ExperimentalWarning --test \"contracts/test/*.test.ts\" \"hub/test/*.test.ts\"",
    "contract:schema": "node contracts/scripts/emit-schema.ts",
    "recorder": "node tools/hook-recorder/recorder.mjs"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
